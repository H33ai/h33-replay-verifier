target/
**/*.rs.bk

# Cargo.lock is COMMITTED at the workspace root — this is an end-product
# workspace (binary + cdylib), and reproducible builds depend on a pinned
# lockfile. The detached WASM crate's separate Cargo.lock stays ignored
# (it's built via wasm-pack, not workspace cargo).

# Built WASM artifacts — generated by `wasm-pack build`, committed into
# playground/wasm/ at release time by the maintainer, not source-controlled
# in the WASM crate itself.
crates/h33-replay-verify-wasm/pkg/
crates/h33-replay-verify-wasm/Cargo.lock
crates/h33-replay-verify-wasm/target/

# Operator-generated verifier identity (never check in)
.h33-replay-verify/

# Local scratch
.DS_Store
